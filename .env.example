# Copie ce fichier en .env (jamais committé) pour l'exécution locale.
# Sur GitHub : Settings > Secrets and variables > Actions > New repository secret.

# --- LLM (Google Gemini). Sans clé => scoring 100% déterministe. ---
GEMINI_API_KEY=

# --- France Travail API (https://francetravail.io, app "Offres d'emploi v2") ---
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Adzuna (https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Gmail : envoi du digest (SMTP) + lecture des alertes (IMAP) ---
# Mot de passe d'application : https://myaccount.google.com/apppasswords
GMAIL_USER=ton.adresse@gmail.com
GMAIL_APP_PASSWORD=

# --- Optionnel : chemin de la base (défaut data/veille.db) ---
VEILLE_DB=
